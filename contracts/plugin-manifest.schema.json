{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/plugin-manifest.schema.json",
  "title": "Malware Plugin Manifest",
  "description": "Source-of-truth schema for plugin package metadata.",
  "$comment": "Schema baseline: manifest_version 1.0.0",
  "type": "object",
  "required": [
    "manifest_version",
    "name",
    "version",
    "api_version",
    "entrypoint",
    "capabilities",
    "integrity"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:[-+].*)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:[-+].*)?$"
    },
    "api_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:[-+].*)?$"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[^\\s]+\\.wasm$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "analysis.read_input",
          "analysis.emit_result",
          "fs.read_sample",
          "fs.write_artifact",
          "net.egress"
        ]
      },
      "uniqueItems": true
    },
    "integrity": {
      "type": "object",
      "required": ["sha256", "signature"],
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "signature": {
          "type": "string"
        }
      }
    }
  }
}
